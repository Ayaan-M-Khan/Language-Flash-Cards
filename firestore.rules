rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'streak', 'totalReviews', 'cardsMastered']) &&
        data.keys().hasOnly([
          'userId', 'email', 'displayName', 'photoURL', 'streak',
          'lastStudiedDate', 'totalReviews', 'cardsMastered', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == userId &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('lastStudiedDate' in data) || (data.lastStudiedDate is string && data.lastStudiedDate.size() <= 30)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
        data.streak is number && data.streak >= 0 &&
        data.totalReviews is number && data.totalReviews >= 0 &&
        data.cardsMastered is number && data.cardsMastered >= 0;
    }

    function isValidDeck(data, userId, deckId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'language', 'languageCode', 'color']) &&
        data.keys().hasOnly([
          'id', 'userId', 'title', 'language', 'languageCode',
          'color', 'description', 'icon', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 && data.id == deckId &&
        data.userId is string && data.userId.size() <= 128 && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.language is string && data.language.size() > 0 && data.language.size() <= 50 &&
        data.languageCode is string && data.languageCode.size() > 0 && data.languageCode.size() <= 20 &&
        data.color is string && data.color.size() <= 30 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidFlashcard(data, userId, deckId, cardId) {
      return data.keys().hasAll([
          'id', 'deckId', 'userId', 'english', 'targetWord',
          'state', 'repetitions', 'intervalDays', 'easeFactor', 'dueDate'
        ]) &&
        data.keys().hasOnly([
          'id', 'deckId', 'userId', 'orderIndex', 'english', 'targetWord',
          'language', 'phonetic', 'partOfSpeech', 'category', 'notes',
          'state', 'repetitions', 'intervalDays', 'easeFactor', 'dueDate',
          'lastReviewedAt', 'exampleSentence', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 && data.id == cardId &&
        data.deckId is string && data.deckId.size() <= 128 && data.deckId == deckId &&
        data.userId is string && data.userId.size() <= 128 && data.userId == userId &&
        (!('orderIndex' in data) || (data.orderIndex is number && data.orderIndex >= 0)) &&
        data.english is string && data.english.size() <= 500 &&
        data.targetWord is string && data.targetWord.size() <= 500 &&
        (!('language' in data) || (data.language is string && data.language.size() <= 50)) &&
        (!('phonetic' in data) || (data.phonetic is string && data.phonetic.size() <= 200)) &&
        (!('partOfSpeech' in data) || (data.partOfSpeech is string && data.partOfSpeech.size() <= 50)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (data.state in ['new', 'learning', 'review', 'mastered']) &&
        data.repetitions is number && data.repetitions >= 0 &&
        data.intervalDays is number && data.intervalDays >= 0 &&
        data.easeFactor is number && data.easeFactor >= 1.0 &&
        data.dueDate is string && data.dueDate.size() <= 40 &&
        (!('lastReviewedAt' in data) || (data.lastReviewedAt is string && data.lastReviewedAt.size() <= 40)) &&
        (!('exampleSentence' in data) || (data.exampleSentence is map)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidReviewLog(data, userId, logId) {
      return data.keys().hasAll(['id', 'userId', 'cardId', 'rating', 'intervalDays']) &&
        data.keys().hasOnly([
          'id', 'userId', 'deckId', 'cardId', 'rating', 'intervalDays',
          'easeFactor', 'repetitions', 'reviewedAt', 'timestamp', 'dateStr'
        ]) &&
        data.id is string && data.id.size() <= 128 && data.id == logId &&
        data.userId is string && data.userId.size() <= 128 && data.userId == userId &&
        (!('deckId' in data) || (data.deckId is string && data.deckId.size() <= 128)) &&
        data.cardId is string && data.cardId.size() <= 128 &&
        (data.rating in ['again', 'hard', 'good', 'easy']) &&
        data.intervalDays is number && data.intervalDays >= 0 &&
        (!('easeFactor' in data) || (data.easeFactor is number && data.easeFactor >= 1.0)) &&
        (!('repetitions' in data) || (data.repetitions is number && data.repetitions >= 0)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 40)) &&
        (!('dateStr' in data) || (data.dateStr is string && data.dateStr.size() <= 20));
    }

    function isValidDailyProgress(data, userId) {
      return data.keys().hasAll(['userId', 'totalReviews', 'dailyReviews']) &&
        data.keys().hasOnly(['userId', 'totalReviews', 'dailyReviews', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == userId &&
        data.totalReviews is number && data.totalReviews >= 0 &&
        data.dailyReviews is map &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'streak',
          'lastStudiedDate', 'totalReviews', 'cardsMastered', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isOwner(userId);

      // User Decks
      match /decks/{deckId} {
        allow get: if isOwner(userId) && isValidId(deckId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(deckId) && isValidDeck(incoming(), userId, deckId);
        allow update: if isOwner(userId) && isValidId(deckId) && isValidDeck(incoming(), userId, deckId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'language', 'languageCode', 'color',
            'description', 'icon', 'createdAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(deckId);

        // Flashcards within Deck
        match /cards/{cardId} {
          allow get: if isOwner(userId) && isValidId(deckId) && isValidId(cardId);
          allow list: if isOwner(userId) && isValidId(deckId);
          allow create: if isOwner(userId) && isValidId(deckId) && isValidId(cardId) &&
            isValidFlashcard(incoming(), userId, deckId, cardId);
          allow update: if isOwner(userId) && isValidId(deckId) && isValidId(cardId) &&
            isValidFlashcard(incoming(), userId, deckId, cardId) &&
            incoming().id == existing().id &&
            incoming().deckId == existing().deckId &&
            incoming().userId == existing().userId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderIndex', 'english', 'targetWord', 'language', 'phonetic',
              'partOfSpeech', 'category', 'notes', 'state', 'repetitions',
              'intervalDays', 'easeFactor', 'dueDate', 'lastReviewedAt',
              'exampleSentence', 'createdAt', 'updatedAt'
            ]);
          allow delete: if isOwner(userId) && isValidId(deckId) && isValidId(cardId);
        }
      }

      // Review event logs
      match /reviews/{reviewId} {
        allow get: if isOwner(userId) && isValidId(reviewId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reviewId) &&
          isValidReviewLog(incoming(), userId, reviewId);
        allow update: if isOwner(userId) && isValidId(reviewId) &&
          isValidReviewLog(incoming(), userId, reviewId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'rating', 'intervalDays', 'reviewedAt', 'timestamp', 'dateStr'
          ]);
        allow delete: if isOwner(userId) && isValidId(reviewId);
      }

      // Historical study logs
      match /studyLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) &&
          isValidReviewLog(incoming(), userId, logId);
        allow update: if isOwner(userId) && isValidId(logId) &&
          isValidReviewLog(incoming(), userId, logId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'rating', 'intervalDays', 'reviewedAt', 'timestamp', 'dateStr'
          ]);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Aggregated daily progress tracking
      match /progress/{progressId} {
        allow get: if isOwner(userId) && isValidId(progressId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(progressId) &&
          isValidDailyProgress(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(progressId) &&
          isValidDailyProgress(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'totalReviews', 'dailyReviews', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(progressId);
      }
    }
  }
}
